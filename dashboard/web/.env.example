# Local dev against the Firebase Emulator Suite (no real project needed):
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-hnh-dashboard

# Real project: Firebase console → Project settings → Your apps → Web app config.
# These identify the project and are not secrets; access is enforced by Auth + Firestore rules.
# VITE_USE_EMULATORS=false
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_ADMOB_CONNECT_URL=https://<region>-<project>.cloudfunctions.net/admobOauthStart
