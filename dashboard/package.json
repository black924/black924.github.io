{
  "name": "hnh-revenue-dashboard-root",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "sh scripts/firebase.sh emulators:start --project demo-hnh-dashboard --only auth,firestore --import .emulator-data --export-on-exit .emulator-data",
    "seed": "vite-node scripts/seed-emulator.ts",
    "test:rules": "sh scripts/firebase.sh emulators:exec --project demo-rules-test --only firestore \"vitest run --dir tests\"",
    "simulate": "vite-node scripts/simulate-emulator.ts",
    "test:rules:running": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 vitest run --dir tests"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "vitest": "2.1.8"
  }
}
